# CEREVIX AI Backend Server Environment Configuration
# Copy this file to .env for local development. NEVER commit .env or real secrets to git.
# In Google Cloud Run production, inject these via Google Cloud Secret Manager.

NODE_ENV=development
PORT=8080

# Gemini API (Server-side only - NEVER expose to mobile/web clients)
GEMINI_API_KEY=

# Optional Additional Provider Credentials (Server-side only)
OPENAI_API_KEY=
VIDEO_PROVIDER_API_KEY=
SPEECH_PROVIDER_API_KEY=
SFX_PROVIDER_API_KEY=
SELF_HOSTED_CEREVIX_URL=
SELF_HOSTED_CEREVIX_TOKEN=

# Razorpay Payment Gateway (Use Test Mode rzp_test_... keys first before Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Project & Trusted Admin SDK Service Account JSON (or base64 / path)
FIREBASE_PROJECT_ID=gen-lang-client-0458088105
FIREBASE_DATABASE_ID=ai-studio-android-cerevixa-b25ada9e-127b-4d39-ab3b-e187571415b7
FIREBASE_SERVICE_ACCOUNT=

# Cryptographic HMAC Pepper for Hashing CEREVIX API Keys (32+ random bytes hex)
CEREVIX_API_SECRET=

# Public Application & API Gateway URLs
APP_BASE_URL=http://localhost:8080
API_BASE_URL=https://api.cerevix.ai/v1

# Comma-separated owner/admin emails (requires verified Firebase Auth email)
ADMIN_EMAILS=prakashprusty334@gmail.com
